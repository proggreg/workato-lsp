{
  "name": "workato-connector",
  "displayName": "Workato Connector",
  "description": "Language support for Workato Connector SDK development",
  "publisher": "gregfield",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ruby"
  ],
  "contributes": {
    "configuration": {
      "title": "Workato Connector",
      "properties": {
        "workatoConnector.rubyVersion": {
          "type": "string",
          "enum": [
            "auto",
            "3.4",
            "3.3",
            "3.2",
            "3.1",
            "3.0",
            "2.7"
          ],
          "enumDescriptions": [
            "Detect Ruby from your shell PATH (recommended)",
            "Ruby 3.4",
            "Ruby 3.3",
            "Ruby 3.2",
            "Ruby 3.1",
            "Ruby 3.0",
            "Ruby 2.7"
          ],
          "default": "auto",
          "description": "Ruby version to use for RuboCop formatting. When set, the extension will prefer that version's rubocop binary."
        }
      }
    },
    "languages": [
      {
        "id": "ruby",
        "aliases": [
          "Ruby",
          "ruby"
        ],
        "extensions": [
          ".rb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ruby",
        "scopeName": "source.ruby",
        "path": "./syntaxes/ruby.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "workatoConnector.formatBlock",
        "title": "Format Block",
        "category": "Workato"
      }
    ],
    "keybindings": [
      {
        "command": "workatoConnector.formatBlock",
        "key": "ctrl+k ctrl+shift+f",
        "mac": "cmd+k cmd+shift+f",
        "when": "editorTextFocus && editorLangId == ruby"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.109.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
