{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug LSP Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/server.js",
      "args": ["--stdio"],
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug LSP Server with Test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/debug-with-test.js",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach to LSP Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}